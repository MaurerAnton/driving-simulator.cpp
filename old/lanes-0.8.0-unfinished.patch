+bool LaneGraph::besideLanes(double x, double z, double y, double need, PathFoot& out) {
+  out.x = x;
+  out.z = z;
+  PathFoot postFoot;
+  for (int tries = 0; tries < 5; tries++) {
+    const double d = nearestPath(out.x, out.z, y, need, postFoot);
+    if (d >= need) {
+      out.d = std::hypot(out.x - x, out.z - z);
+      return true;
+    }
+    // away from the middle of that lane (straight out of it; from dead centre towards where the post came from)
+    double ux = out.x - postFoot.x;
+    double uz = out.z - postFoot.z;
+    if (d < 0.05) {
+      ux = x - postFoot.x;
+      uz = z - postFoot.z;
+      if (std::hypot(ux, uz) < 0.05) return false;
+    }
+    const double l = std::hypot(ux, uz);
+    out.x = postFoot.x + (ux / l) * (need + 0.15);
+    out.z = postFoot.z + (uz / l) * (need + 0.15);
+    if (std::hypot(out.x - x, out.z - z) > 4.5) return false;
+  }
+  return false;
+}
