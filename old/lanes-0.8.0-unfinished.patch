+double LaneGraph::nearestPath(double x, double z, double y, double reach, PathFoot& out) {
+  double best = reach;
+  bool found = false;
+  PolyProjection proj;
+  PolySample smp;
+  world.segmentsInBox(x - reach, z - reach, x + reach, z + reach, [&](const Edge& e, int seg) {
+    if (e.id < 0 || static_cast<size_t>(e.id) >= edgeLanes.size()) return;
+    const EdgeLanes& el = edgeLanes[static_cast<size_t>(e.id)];
+    if (el.fwd.empty() && el.back.empty()) return;
+    proj = projectOnPolyline(e.pl, x, z, proj, seg, seg);
+    const double far = e.width / 2 + best;
+    if (proj.d2 > far * far) return;
+    // (the lanes run between the junction areas at the two ends)
+    smp = samplePolyline(e.pl, clamp(proj.s, e.cutA, std::max(e.cutA, e.len - e.cutB)), smp);
+    if (!std::isnan(y) && std::fabs(smp.y - y) > 2.6) return;
+    for (int side = 0; side < 2; side++) {
+      const std::vector<Lane*>& list = side == 0 ? el.fwd : el.back;
+      for (size_t i = 0; i < list.size(); i++) {
+        const double px = smp.x + smp.tz * list[i]->off;
+        const double pz = smp.z - smp.tx * list[i]->off;
+        const double d = std::hypot(x - px, z - pz);
+        if (d < best) {
+          best = d;
+          out.x = px;
+          out.z = pz;
+          found = true;
+        }
+      }
+    }
+  });
+  world.nodesInBox(x - reach, z - reach, x + reach, z + reach, [&](Node& node) {
+    if (!std::isnan(y) && std::fabs(world.planeY(node, x, z) - y) > 2.6) return;
+    auto it = pathsAt_.find(node.id);
+    if (it == pathsAt_.end()) return;
+    for (int id : it->second) {
+      Connector* c = (id >= 0 && static_cast<size_t>(id) < livePaths_.size())
+                         ? livePaths_[static_cast<size_t>(id)]
+                         : nullptr;
+      if (!c) continue;
+      proj = projectOnPolyline(c->pl, x, z, proj);
+      if (proj.d2 >= best * best) continue;
+      best = std::sqrt(proj.d2);
+      smp = samplePolyline(c->pl, proj.s, smp);
+      out.x = smp.x;
+      out.z = smp.z;
+      found = true;
+    }
+  });
+  out.d = found ? best : std::numeric_limits<double>::infinity();
+  return out.d;
+}
