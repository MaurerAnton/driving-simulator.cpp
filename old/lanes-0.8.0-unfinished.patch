+bool LaneGraph::wallInLane(double x1, double z1, double x2, double z2, double y, double need) {
+  const double minX = std::min(x1, x2) - need;
+  const double maxX = std::max(x1, x2) + need;
+  const double minZ = std::min(z1, z2) - need;
+  const double maxZ = std::max(z1, z2) + need;
+  const double need2 = need * need;
+  bool hit = false;
+  world.segmentsInBox(minX, minZ, maxX, maxZ, [&](const Edge& e, int seg) {
+    if (hit) return;
+    if (e.id < 0 || static_cast<size_t>(e.id) >= edgeLanes.size()) return;
+    const EdgeLanes& el = edgeLanes[static_cast<size_t>(e.id)];
+    if (el.fwd.empty() && el.back.empty()) return;
+    const auto& p = e.pl.pts;
+    const double ax = p[static_cast<size_t>(seg) * 3];
+    const double ay = p[static_cast<size_t>(seg) * 3 + 1];
+    const double az = p[static_cast<size_t>(seg) * 3 + 2];
+    const double bx = p[static_cast<size_t>(seg) * 3 + 3];
+    const double bz = p[static_cast<size_t>(seg) * 3 + 5];
+    if (!std::isnan(y) &&
+        std::fabs((ay + p[static_cast<size_t>(seg) * 3 + 4]) / 2 - y) >
+            2.6 + std::fabs(ay - p[static_cast<size_t>(seg) * 3 + 4]) / 2)
+      return;
+    // (most pieces of road in reach of the grid are nowhere near the wall)
+    const double far = e.width / 2 + need;
+    if (std::max(ax, bx) + far < minX + need || std::min(ax, bx) - far > maxX - need ||
+        std::max(az, bz) + far < minZ + need || std::min(az, bz) - far > maxZ - need)
+      return;
+    const double l = std::hypot(bx - ax, bz - az);
+    if (l < 1e-6) return;
+    // left of the direction of travel a→b
+    const double nx = (bz - az) / l;
+    const double nz = -(bx - ax) / l;
+    for (int side = 0; side < 2 && !hit; side++) {
+      const std::vector<Lane*>& list = side == 0 ? el.fwd : el.back;
+      for (size_t i = 0; i < list.size(); i++) {
+        const double o = list[i]->off;
+        if (segSegDist2(x1, z1, x2, z2, ax + nx * o, az + nz * o, bx + nx * o, bz + nz * o) <
+            need2) {
+          hit = true;
+          break;
+        }
+      }
+    }
+  });
+  if (hit) return true;
+  world.nodesInBox(minX, minZ, maxX, maxZ, [&](Node& node) {
+    if (hit) return;
+    if (!std::isnan(y) &&
+        std::fabs(world.planeY(node, (x1 + x2) / 2, (z1 + z2) / 2) - y) > 2.6)
+      return;
+    auto it = pathsAt_.find(node.id);
+    if (it == pathsAt_.end()) return;
+    for (int id : it->second) {
+      Connector* c = (id >= 0 && static_cast<size_t>(id) < livePaths_.size())
+                         ? livePaths_[static_cast<size_t>(id)]
+                         : nullptr;
+      if (!c) continue;
+      const auto& p = c->pl.pts;
+      for (size_t i = 0; i + 5 < p.size(); i += 3) {
+        if (segSegDist2(x1, z1, x2, z2, p[i], p[i + 2], p[i + 3], p[i + 5]) < need2) {
+          hit = true;
+          break;
+        }
+      }
+      if (hit) break;
+    }
+  });
+  return hit;
+}
