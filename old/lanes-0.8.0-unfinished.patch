+void LaneGraph::removeEdge(Edge& e) {
+  if (e.id < 0 || static_cast<size_t>(e.id) >= edgeLanes.size()) return;
+  EdgeLanes& el = edgeLanes[static_cast<size_t>(e.id)];
+  std::vector<Lane*> all;
+  all.insert(all.end(), el.fwd.begin(), el.fwd.end());
+  all.insert(all.end(), el.back.begin(), el.back.end());
+  for (Lane* lane : all) {
+    if (!lane) continue;
+    // (paths of a junction that stays, as the end of another road, cannot lead here any more)
+    std::vector<Connector*> paths = lane->out;
+    paths.insert(paths.end(), lane->in.begin(), lane->in.end());
+    for (Connector* c : paths)
+      if (c) dropPath(*c);
+    lane->out.clear();
+    lane->in.clear();
+    if (lane->id >= 0 && static_cast<size_t>(lane->id) < live_.size()) {
+      live_[static_cast<size_t>(lane->id)] = nullptr;
+      freeLanes_.push_back(lane->id);
+    }
+  }
+  el.fwd.clear();
+  el.back.clear();
+}
+
+void LaneGraph::dropPath(Connector& c) {
+  auto drop = [](std::vector<Connector*>& list, Connector* p) {
+    auto it = std::find(list.begin(), list.end(), p);
+    if (it != list.end()) list.erase(it);
+  };
+  if (c.from) drop(c.from->out, &c);
+  if (c.to) drop(c.to->in, &c);
+  auto at = pathsAt_.find(c.node ? c.node->id : -1);
+  if (at != pathsAt_.end()) {
+    auto it = std::find(at->second.begin(), at->second.end(), c.id);
+    if (it != at->second.end()) at->second.erase(it);
+  }
+  if (c.id >= 0 && static_cast<size_t>(c.id) < livePaths_.size() &&
+      livePaths_[static_cast<size_t>(c.id)] == &c) {
+    livePaths_[static_cast<size_t>(c.id)] = nullptr;
+    freePaths_.push_back(c.id);
+    c.live = false;
+  }
+}
+
+void LaneGraph::removeNode(Node& node) {
+  auto it = pathsAt_.find(node.id);
+  if (it != pathsAt_.end()) {
+    std::vector<int> ids = it->second;
+    for (int id : ids)
+      if (id >= 0 && static_cast<size_t>(id) < livePaths_.size() && livePaths_[static_cast<size_t>(id)])
+        dropPath(*livePaths_[static_cast<size_t>(id)]);
+    pathsAt_.erase(node.id);
+  }
+  resolved_.erase(node.id);
+}
